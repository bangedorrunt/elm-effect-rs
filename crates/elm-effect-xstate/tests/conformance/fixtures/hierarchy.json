[
  {
    "name": "initial_compound_state_resolution",
    "description": "Proves transition to compound state resolves directly to initial sub-state",
    "machine": {
      "initial": "A",
      "context": { "log": [] },
      "states": {
        "A": {
          "on": {
            "ENTER_PARENT": "Parent"
          }
        },
        "Parent": {
          "type": "compound",
          "initial": "Child1",
          "entry": ["enter_parent"],
          "states": {}
        },
        "Child1": {
          "parent": "Parent",
          "entry": ["enter_child1"]
        }
      }
    },
    "events": [
      { "type": "ENTER_PARENT" }
    ],
    "expected": {
      "final_state": "Child1",
      "trace": [
        "enter_parent",
        "enter_child1"
      ]
    }
  },
  {
    "name": "transition_within_same_compound_preserves_parent",
    "description": "Proves transition between sibling child states does not exit or re-enter common parent",
    "machine": {
      "initial": "Parent",
      "context": { "log": [] },
      "states": {
        "Parent": {
          "type": "compound",
          "initial": "Child1",
          "entry": ["enter_parent"],
          "exit": ["exit_parent"]
        },
        "Child1": {
          "parent": "Parent",
          "entry": ["enter_child1"],
          "exit": ["exit_child1"],
          "on": {
            "STEP": "Child2"
          }
        },
        "Child2": {
          "parent": "Parent",
          "entry": ["enter_child2"],
          "exit": ["exit_child2"]
        }
      }
    },
    "events": [
      { "type": "STEP" }
    ],
    "expected": {
      "final_state": "Child2",
      "trace": [
        "enter_parent",
        "enter_child1",
        "exit_child1",
        "enter_child2"
      ]
    }
  },
  {
    "name": "event_bubbling_to_compound_parent",
    "description": "Proves unhandled event in child bubbles up to parent transition",
    "machine": {
      "initial": "Parent",
      "context": { "log": [] },
      "states": {
        "Parent": {
          "type": "compound",
          "initial": "Child",
          "entry": ["enter_parent"],
          "exit": ["exit_parent"],
          "on": {
            "CANCEL": "Cancelled"
          }
        },
        "Child": {
          "parent": "Parent",
          "entry": ["enter_child"],
          "exit": ["exit_child"]
        },
        "Cancelled": {
          "entry": ["enter_cancelled"]
        }
      }
    },
    "events": [
      { "type": "CANCEL" }
    ],
    "expected": {
      "final_state": "Cancelled",
      "trace": [
        "enter_parent",
        "enter_child",
        "exit_child",
        "exit_parent",
        "enter_cancelled"
      ]
    }
  },
  {
    "name": "three_level_event_bubbling",
    "description": "Proves an event bubbles through two compound ancestors",
    "machine": {
      "initial": "Root",
      "context": { "log": [] },
      "states": {
        "Root": {
          "type": "compound",
          "initial": "Mid",
          "entry": ["enter_root"],
          "exit": ["exit_root"],
          "on": { "STOP": "Stopped" }
        },
        "Mid": {
          "type": "compound",
          "initial": "Leaf",
          "parent": "Root",
          "entry": ["enter_mid"],
          "exit": ["exit_mid"]
        },
        "Leaf": {
          "parent": "Mid",
          "entry": ["enter_leaf"],
          "exit": ["exit_leaf"]
        },
        "Stopped": { "entry": ["enter_stopped"] }
      }
    },
    "events": [{ "type": "STOP" }],
    "expected": {
      "final_state": "Stopped",
      "trace": [
        "enter_root",
        "enter_mid",
        "enter_leaf",
        "exit_leaf",
        "exit_mid",
        "exit_root",
        "enter_stopped"
      ]
    }
  },
  {
    "name": "sibling_compound_transition_stays_under_the_lca",
    "description": "Proves a cross-branch transition exits to the LCA without re-entering it",
    "machine": {
      "initial": "Root",
      "context": { "log": [] },
      "states": {
        "Root": {
          "type": "compound",
          "initial": "Left",
          "entry": ["enter_root"],
          "exit": ["exit_root"]
        },
        "Left": {
          "type": "compound",
          "initial": "LeftA",
          "parent": "Root",
          "entry": ["enter_left"],
          "exit": ["exit_left"]
        },
        "LeftA": {
          "parent": "Left",
          "entry": ["enter_left_a"],
          "exit": ["exit_left_a"],
          "on": { "SWITCH": "RightB" }
        },
        "Right": {
          "type": "compound",
          "initial": "RightA",
          "parent": "Root",
          "entry": ["enter_right"]
        },
        "RightA": { "parent": "Right", "entry": ["enter_right_a"] },
        "RightB": { "parent": "Right", "entry": ["enter_right_b"] }
      }
    },
    "events": [{ "type": "SWITCH" }],
    "expected": {
      "final_state": "RightB",
      "trace": [
        "enter_root",
        "enter_left",
        "enter_left_a",
        "exit_left_a",
        "exit_left",
        "enter_right",
        "enter_right_b"
      ]
    }
  },
  {
    "name": "parent_self_transition_reenters_its_child",
    "description": "Proves a compound self-transition exits and re-enters the whole subtree",
    "machine": {
      "initial": "Root",
      "context": { "log": [] },
      "states": {
        "Root": {
          "type": "compound",
          "initial": "A",
          "entry": ["enter_root"],
          "exit": ["exit_root"],
          "on": { "RESET": "Root" }
        },
        "A": {
          "parent": "Root",
          "entry": ["enter_a"],
          "exit": ["exit_a"]
        }
      }
    },
    "events": [{ "type": "RESET" }],
    "expected": {
      "final_state": "A",
      "trace": [
        "enter_root",
        "enter_a",
        "exit_a",
        "exit_root",
        "enter_root",
        "enter_a"
      ]
    }
  }
]
