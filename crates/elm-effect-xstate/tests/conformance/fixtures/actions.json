[
  {
    "name": "strict_l1_execution_order",
    "description": "Proves exit(source) -> transition actions -> entry(target) order",
    "machine": {
      "initial": "A",
      "context": { "log": [] },
      "states": {
        "A": {
          "type": "atomic",
          "entry": ["enter_A"],
          "exit": ["exit_A"],
          "on": {
            "STEP": {
              "target": "B",
              "actions": ["action_A_to_B", "assign_ctx"]
            }
          }
        },
        "B": {
          "type": "atomic",
          "entry": ["enter_B"],
          "exit": ["exit_B"]
        }
      }
    },
    "events": [
      { "type": "STEP" }
    ],
    "expected": {
      "final_state": "B",
      "trace": [
        "enter_A",
        "exit_A",
        "action_A_to_B",
        "assign_ctx",
        "enter_B"
      ]
    }
  },
  {
    "name": "self_transition_exits_and_reenters",
    "description": "Proves reenter:true exits the source and re-enters the target",
    "machine": {
      "initial": "A",
      "context": { "log": [] },
      "states": {
        "A": {
          "type": "atomic",
          "entry": ["enter_A"],
          "exit": ["exit_A"],
          "on": {
            "REFRESH": {
              "target": "A",
              "reenter": true,
              "actions": ["action_self"]
            }
          }
        }
      }
    },
    "events": [
      { "type": "REFRESH" }
    ],
    "expected": {
      "final_state": "A",
      "trace": [
        "enter_A",
        "exit_A",
        "action_self",
        "enter_A"
      ]
    }
  },
