[
  {
    "name": "strict_l1_execution_order",
    "description": "Proves exit(source) -> transition actions -> entry(target) order",
    "machine": {
      "initial": "A",
      "context": { "log": [] },
      "states": {
        "A": {
          "type": "atomic",
          "entry": ["enter_A"],
          "exit": ["exit_A"],
          "on": {
            "STEP": {
              "target": "B",
              "actions": ["action_A_to_B", "assign_ctx"]
            }
          }
        },
        "B": {
          "type": "atomic",
          "entry": ["enter_B"],
          "exit": ["exit_B"]
        }
      }
    },
    "events": [
      { "type": "STEP" }
    ],
    "expected": {
      "final_state": "B",
      "trace": [
        "enter_A",
        "exit_A",
        "action_A_to_B",
        "assign_ctx",
        "enter_B"
      ]
    }
  },
  {
    "name": "self_transition_exits_and_reenters",
    "description": "Proves self-transition exits source and re-enters target",
    "machine": {
      "initial": "A",
      "context": { "log": [] },
      "states": {
        "A": {
          "type": "atomic",
          "entry": ["enter_A"],
          "exit": ["exit_A"],
          "on": {
            "REFRESH": {
              "target": "A",
              "actions": ["action_self"]
            }
          }
        }
      }
    },
    "events": [
      { "type": "REFRESH" }
    ],
    "expected": {
      "final_state": "A",
      "trace": [
        "enter_A",
        "exit_A",
        "action_self",
        "enter_A"
      ]
    }
  },
  {
    "name": "multiple_entry_and_exit_actions_declaration_order",
    "description": "Proves multiple entry and exit actions execute in exact declaration order",
    "machine": {
      "initial": "A",
      "context": { "log": [] },
      "states": {
        "A": {
          "entry": ["enter_A_1", "enter_A_2"],
          "exit": ["exit_A_1", "exit_A_2"],
          "on": {
            "NEXT": {
              "target": "B",
              "actions": ["trans_1", "trans_2"]
            }
          }
        },
        "B": {
          "entry": ["enter_B_1", "enter_B_2"],
          "exit": []
        }
      }
    },
    "events": [
      { "type": "NEXT" }
    ],
    "expected": {
      "final_state": "B",
      "trace": [
        "enter_A_1",
        "enter_A_2",
        "exit_A_1",
        "exit_A_2",
        "trans_1",
        "trans_2",
        "enter_B_1",
        "enter_B_2"
      ]
    }
  },
  {
    "name": "nested_exit_and_entry_are_topological",
    "description": "Proves a parent exit runs after its child and a parent entry runs before its child",
    "machine": {
      "initial": "Root",
      "context": { "log": [] },
      "states": {
        "Root": {
          "type": "compound",
          "initial": "A",
          "entry": ["enter_root"],
          "exit": ["exit_root"],
          "on": { "STOP": "Stopped" }
        },
        "A": { "parent": "Root", "entry": ["enter_a"], "exit": ["exit_a"] },
        "Stopped": { "entry": ["enter_stopped"] }
      }
    },
    "events": [{ "type": "STOP" }],
    "expected": {
      "final_state": "Stopped",
      "trace": ["enter_root", "enter_a", "exit_a", "exit_root", "enter_stopped"]
    }
  },
  {
    "name": "internal_target_keeps_source_active",
    "description": "Proves a target strictly inside the source does not exit the source",
    "machine": {
      "initial": "Root",
      "context": { "log": [] },
      "states": {
        "Root": {
          "type": "compound",
          "initial": "A",
          "entry": ["enter_root"],
          "exit": ["exit_root"],
          "on": { "NEXT": "B" }
        },
        "A": { "parent": "Root", "entry": ["enter_a"], "exit": ["exit_a"] },
        "B": { "parent": "Root", "entry": ["enter_b"] }
      }
    },
    "events": [{ "type": "NEXT" }],
    "expected": {
      "final_state": "B",
      "trace": ["enter_root", "enter_a", "exit_a", "enter_b"]
    }
  },
  {
    "name": "a_raised_event_is_consumed_in_the_same_macrostep",
    "description": "Proves enq.raise feeds the internal queue before the step returns",
    "machine": {
      "initial": "A",
      "context": { "log": [] },
      "states": {
        "A": {
          "entry": ["enter_a"],
          "on": { "GO": { "target": "B", "actions": ["raise:PING"] } }
        },
        "B": { "entry": ["enter_b"], "on": { "PING": "C" } },
        "C": { "entry": ["enter_c"] }
      }
    },
    "events": [{ "type": "GO" }],
    "expected": {
      "final_state": "C",
      "trace": ["enter_a", "enter_b", "enter_c"]
    }
  },
  {
    "name": "emitted_payloads_reach_inspection",
    "description": "Proves enq.emit exposes its payload on the step outcome",
    "machine": {
      "initial": "A",
      "context": { "log": [] },
      "states": {
        "A": {
          "entry": ["enter_a"],
          "on": { "GO": { "target": "B", "actions": ["emit:audit"] } }
        },
        "B": { "entry": ["enter_b"] }
      }
    },
    "events": [{ "type": "GO" }],
    "expected": {
      "final_state": "B",
      "emitted": ["audit"],
      "trace": ["enter_a", "enter_b"]
    }
  },
{
  "name": "parallel_raised_events_execute_in_order",
  "description": "Upstream transient: both regions raise on entry and the internal queue drains INT1 before INT2",
  "source": "xstate@6.0.0-beta.1 commit d56483f packages/core/test/transient.test.ts: should execute all internal events one after the other",
  "machine": {
    "initial": "Root",
    "context": {
      "log": []
    },
    "states": {
      "Root": {
        "type": "parallel"
      },
      "A": {
        "type": "compound",
        "initial": "A1",
        "parent": "Root"
      },
      "A1": {
        "parent": "A",
        "on": {
          "E": "A2"
        }
      },
      "A2": {
        "parent": "A",
        "entry": [
          "raise:INT1"
        ]
      },
      "B": {
        "type": "compound",
        "initial": "B1",
        "parent": "Root"
      },
      "B1": {
        "parent": "B",
        "on": {
          "E": "B2"
        }
      },
      "B2": {
        "parent": "B",
        "entry": [
          "raise:INT2"
        ]
      },
      "C": {
        "type": "compound",
        "initial": "C1",
        "parent": "Root"
      },
      "C1": {
        "parent": "C",
        "on": {
          "INT1": "C2",
          "INT2": "C3"
        }
      },
      "C2": {
        "parent": "C",
        "on": {
          "INT2": "C4"
        }
      },
      "C3": {
        "parent": "C",
        "on": {
          "INT1": "C4"
        }
      },
      "C4": {
        "parent": "C"
      }
    }
  },
  "events": [
    {
      "type": "E"
    }
  ],
  "expected": {
    "final_state": "A2",
    "final_states": [
      "A2",
      "B2",
      "C4"
    ],
    "trace": []
  }
}
]
