{
  "name": "history_internal_relative_target",
  "description": "Upstream history: a dot target reaches the history node inside the source state and uses its default",
  "source": "xstate@6.0.0-beta.1 commit d56483f packages/core/test/history.test.ts: internal transition to a history state should enter default history state configuration if the containing state has never been exited yet",
  "machine": {
    "initial": "First",
    "context": {
      "log": []
    },
    "states": {
      "First": {
        "on": {
          "NEXT": "Second.Other"
        }
      },
      "Second": {
        "type": "compound",
        "initial": "Nested",
        "on": {
          "NEXT": ".Hist"
        }
      },
      "Nested": {
        "parent": "Second"
      },
      "Other": {
        "parent": "Second"
      },
      "Hist": {
        "type": "history",
        "initial": "Nested",
        "parent": "Second"
      }
