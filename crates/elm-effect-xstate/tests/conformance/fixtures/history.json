{
  "name": "history_target_enters_never_visited_parent",
  "description": "Upstream history: targeting a history state inside a never-visited parent enters the parent and its fallback",
  "source": "xstate@6.0.0-beta.1 commit d56483f packages/core/test/history.test.ts: should execute entry actions of a parent of the targeted history state when its parent state was never visited yet",
  "machine": {
    "initial": "A",
    "context": {
      "log": []
    },
    "states": {
      "A": {
        "on": {
          "NEXT": "Hist"
        }
      },
      "B": {
        "type": "compound",
        "initial": "B1",
        "entry": [
          "enter_b"
        ],
        "on": {
          "NEXT": "A"
        }
      },
      "B1": {
        "parent": "B"
      },
      "Hist": {
        "type": "history",
        "initial": "B3",
        "parent": "B"
      },
      "B3": {
        "parent": "B"
      }
    }
  },
  "events": [
    {
      "type": "NEXT"
    }
  ],
  "expected": {
    "final_state": "B3",
    "trace": [
      "enter_b"
    ]
  }
},
{
  "name": "history_multi_target_deep_default",
  "description": "Upstream history: an unvisited deep parallel history enters every fallback target",
  "source": "xstate@6.0.0-beta.1 commit d56483f packages/core/test/history.test.ts: should enter a legal multi-target default for deep parallel history",
  "machine": {
    "initial": "Off",
    "context": {
      "log": []
    },
    "states": {
      "Off": {
        "on": {
          "GO": "Hist"
        }
      },
      "On": {
        "type": "parallel"
      },
      "A": {
        "type": "compound",
        "initial": "B",
        "parent": "On"
      },
      "B": {
        "parent": "A"
      },
      "C": {
        "parent": "A"
      },
      "K": {
        "type": "compound",
        "initial": "L",
        "parent": "On"
      },
      "L": {
        "parent": "K"
      },
      "M": {
        "parent": "K"
      },
      "Hist": {
        "type": "history",
        "history": "deep",
        "target": [
          "C",
          "M"
        ],
        "parent": "On"
      }
    }
  },
  "events": [
    {
      "type": "GO"
    }
  ],
  "expected": {
    "final_state": "C",
    "final_states": [
      "C",
      "M"
    ],
    "trace": []
  }
},
{
