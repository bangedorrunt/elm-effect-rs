{
  "name": "transient_reentry_updates_the_history_record",
  "description": "Upstream history: a transient transition into the parent updates the visited child before the next exit",
  "source": "xstate@6.0.0-beta.1 commit d56483f packages/core/test/history.test.ts: should go to the most recently visited state by a transient transition",
  "machine": {
    "initial": "Idle",
    "context": {
      "log": []
    },
    "states": {
      "Idle": {
        "type": "compound",
        "initial": "Absent"
      },
      "Absent": {
        "parent": "Idle",
        "on": {
          "DEPLOY": "Deploy"
        }
      },
      "Present": {
        "parent": "Idle",
        "on": {
          "DEPLOY": "Deploy",
          "DESTROY": "Destroy"
        }
      },
      "Hist": {
        "type": "history",
        "initial": "Absent",
        "parent": "Idle"
      },
      "Deploy": {
        "on": {
          "SUCCESS": "Present",
          "FAILURE": "Hist"
        }
      },
      "Destroy": {
        "always": [
          {
            "target": "Absent"
          }
        ]
      }
    }
  },
  "events": [
    {
      "type": "DEPLOY"
    },
    {
      "type": "SUCCESS"
    },
    {
      "type": "DESTROY"
    },
    {
      "type": "DEPLOY"
    },
    {
      "type": "FAILURE"
    }
  ],
  "expected": {
    "final_state": "Absent",
    "trace": []
  }
},
