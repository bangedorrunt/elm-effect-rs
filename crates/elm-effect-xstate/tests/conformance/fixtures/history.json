[
  {
    "name": "shallow_history_restores_the_child_then_its_initial",
    "description": "Proves shallow history remembers the immediate child and resolves its initial",
    "machine": {
      "initial": "Root",
      "context": { "log": [] },
      "states": {
        "Root": {
          "type": "compound",
          "initial": "Active",
          "on": { "STOP": "Stopped" }
        },
        "Active": {
          "type": "compound",
          "initial": "Idle",
          "parent": "Root",
          "entry": ["enter_active"],
          "exit": ["exit_active"]
        },
        "Idle": { "parent": "Active", "entry": ["enter_idle"], "on": { "PLAY": "Paused" } },
        "Paused": {
          "parent": "Active",
          "entry": ["enter_paused"],
          "exit": ["exit_paused"]
        },
        "Stopped": {
          "entry": ["enter_stopped"],
          "on": { "RESUME": "Shallow" }
        },
        "Shallow": {
          "type": "history",
          "initial": "Idle",
          "parent": "Root"
        }
      }
    },
    "events": [
      { "type": "PLAY" },
      { "type": "STOP" },
      { "type": "RESUME" }
    ],
    "expected": {
      "final_state": "Idle",
      "trace": [
        "enter_active",
        "enter_idle",
        "enter_paused",
        "exit_paused",
        "exit_active",
        "enter_stopped",
        "enter_active",
        "enter_idle"
      ]
    }
  },
