{
  "name": "eventless_transition_stays_inside_its_parallel_region",
  "description": "Upstream transient: an eventless microstep in one region leaves the sibling region untouched",
  "source": "xstate@6.0.0-beta.1 commit d56483f packages/core/test/transient.test.ts: eventless transitions are scoped to the active region",
  "machine": {
    "initial": "Root",
    "context": {
      "log": []
    },
    "states": {
      "Root": {
        "type": "parallel"
      },
      "Left": {
        "type": "compound",
        "initial": "L1",
        "parent": "Root"
      },
      "L1": {
        "parent": "Left",
        "on": {
          "EVENT": "L2"
        }
      },
      "L2": {
        "parent": "Left",
        "always": [
          {
            "target": "L3",
            "actions": [
              "left_always"
            ]
          }
        ]
      },
      "L3": {
        "parent": "Left",
        "entry": [
          "enter_l3"
        ]
      },
      "Right": {
        "type": "compound",
        "initial": "R1",
        "parent": "Root"
      },
      "R1": {
        "parent": "Right"
      }
    }
  },
  "events": [
    {
      "type": "EVENT"
    }
  ],
  "expected": {
    "final_state": "L3",
    "final_states": [
      "L3",
      "R1"
    ],
    "trace": [
      "left_always",
      "enter_l3"
    ]
  }
},
