{
  "name": "transient_state_in_microsteps",
  "description": "Upstream transient: interleaved eventless transitions observe interim states in other parallel regions",
  "source": "xstate@6.0.0-beta.1 commit d56483f packages/core/test/transient.test.ts: should execute all eventless transitions in the same microstep",
  "machine": {
    "initial": "Root",
    "context": { "log": [] },
    "states": {
      "Root": { "type": "parallel" },
      "A": { "type": "compound", "initial": "A1", "parent": "Root" },
      "A1": { "parent": "A", "on": { "E": "A2" } },
      "A2": { "parent": "A", "always": [{ "target": "A3" }] },
      "A3": {
        "parent": "A",
        "always": [{ "target": "A4", "guard": "state_in:B.B3" }]
      },
      "A4": { "parent": "A" },
      "B": { "type": "compound", "initial": "B1", "parent": "Root" },
      "B1": { "parent": "B", "on": { "E": "B2" } },
      "B2": {
        "parent": "B",
        "always": [{ "target": "B3", "guard": "state_in:A.A2" }]
      },
      "B3": {
        "parent": "B",
        "always": [{ "target": "B4", "guard": "state_in:A.A3" }]
      },
      "B4": { "parent": "B" }
    }
  },
  "events": [{ "type": "E" }],
  "expected": {
    "final_state": "A4",
    "final_states": ["A4", "B4"],
    "trace": []
  }
},
