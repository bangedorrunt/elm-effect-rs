  {
    "name": "parallel_regions_enter_and_broadcast",
    "description": "Proves a parallel node activates every region and one event reaches all of them",
    "machine": {
      "initial": "Root",
      "context": { "log": [] },
      "states": {
        "Root": { "type": "parallel" },
        "Left": {
          "type": "compound",
          "initial": "LeftA",
          "parent": "Root",
          "entry": ["enter_left"]
        },
        "LeftA": {
          "parent": "Left",
          "entry": ["enter_left_a"],
          "exit": ["exit_left_a"],
          "on": { "NEXT": "LeftB" }
        },
        "LeftB": { "parent": "Left", "entry": ["enter_left_b"] },
        "Right": {
          "type": "compound",
          "initial": "RightA",
          "parent": "Root",
          "entry": ["enter_right"]
        },
        "RightA": {
          "parent": "Right",
          "entry": ["enter_right_a"],
          "exit": ["exit_right_a"],
          "on": { "NEXT": "RightB" }
        },
        "RightB": { "parent": "Right", "entry": ["enter_right_b"] }
      }
    },
    "events": [{ "type": "NEXT" }],
    "expected": {
      "final_state": "LeftB",
      "final_states": ["LeftB", "RightB"],
      "trace": [
        "enter_left",
        "enter_left_a",
        "enter_right",
        "enter_right_a",
        "exit_right_a",
        "exit_left_a",
        "enter_left_b",
        "enter_right_b"
      ]
    }
  },
