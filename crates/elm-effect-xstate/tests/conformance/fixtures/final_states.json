[
  {
    "name": "final_state_is_terminal",
    "description": "Proves reaching final state leaves the machine in terminal quiescence",
    "machine": {
      "initial": "Running",
      "context": { "log": [] },
      "states": {
        "Running": {
          "on": {
            "COMPLETE": "Completed"
          }
        },
        "Completed": {
          "type": "final",
          "entry": ["enter_completed"]
        }
      }
    },
    "events": [
      { "type": "COMPLETE" }
    ],
    "expected": {
      "final_state": "Completed",
      "done": true,
      "trace": [
        "enter_completed"
      ]
    }
  },
  {
    "name": "compound_final_takes_on_done",
    "description": "Proves a final child completes its compound parent and fires onDone",
    "machine": {
      "initial": "Root",
      "context": { "log": [] },
      "states": {
        "Root": { "type": "compound", "initial": "Step", "onDone": "Finished" },
        "Step": { "parent": "Root", "entry": ["enter_step"], "on": { "DONE": "StepDone" } },
        "StepDone": { "type": "final", "parent": "Root", "entry": ["enter_step_done"] },
        "Finished": { "entry": ["enter_finished"] }
      }
    },
    "events": [{ "type": "DONE" }],
    "expected": {
      "final_state": "Finished",
      "done": false,
      "trace": ["enter_step", "enter_step_done", "enter_finished"]
    }
  },
  {
    "name": "final_state_ignores_later_events",
    "description": "Proves a completed machine stays in its final state",
    "machine": {
      "initial": "Running",
      "context": { "log": [] },
      "states": {
        "Running": { "on": { "COMPLETE": "Completed" } },
        "Completed": { "type": "final", "entry": ["enter_completed"] }
      }
    },
    "events": [{ "type": "COMPLETE" }, { "type": "NOOP" }],  "expected": {
    "final_state": "Completed",
    "done": true,
    "trace": ["enter_completed"]
  }
},
{
  "name": "nested_done_actions_run_inside_out",
  "description": "Upstream final: the final child's entry runs before each enclosing onDone transition",
  "source": "xstate@6.0.0-beta.1 commit d56483f packages/core/test/final.test.ts: should execute final child state actions first",
  "machine": {
    "initial": "Foo",
    "context": {
      "log": []
    },
    "states": {
      "Foo": {
        "type": "compound",
        "initial": "Bar",
        "onDone": {
          "target": "Finished",
          "actions": [
            "foo_done"
          ]
        }
      },
      "Bar": {
        "type": "compound",
        "initial": "Baz",
        "parent": "Foo",
        "onDone": "BarFinal"
      },
      "Baz": {
        "type": "final",
        "parent": "Bar",
        "entry": [
          "baz_entry"
        ]
      },
      "BarFinal": {
        "type": "final",
        "parent": "Foo",
        "entry": [
          "bar_final_entry"
        ]
      },
      "Finished": {
        "type": "final"
      }
    }
  },
  "events": [
    {
      "type": "NOOP"
    }
  ],
  "expected": {
    "final_state": "Finished",
    "done": true,
    "trace": [
      "baz_entry",
      "bar_final_entry",
      "foo_done"
    ]
  }
},
